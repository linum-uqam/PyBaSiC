AGENTS.md

# === OpenGSD (gsd-core) — keep ALL GSD-produced files out of git ===
# Runtime installs (Cursor / Claude / Windsurf)
.cursor/
.claude/
.windsurf/
.windsurf/gsd-local-patches/
.windsurf/gsd-pristine/
# Planning workspace — everything GSD writes during discuss/plan/execute/verify/ship
.planning/
# Agent scratch inside planning (doc-verifier JSON, ingest manifests)
.planning/tmp/
# Generated agent instruction / rules files (repo root)
/AGENTS.md
/CLAUDE.md
/GEMINI.md
# Graphify working copy (canonical graph lives under .planning/graphs/)
graphify-out/
# GSD handoffs, repo memories, context intel, specs
handoffs/
memories/
context/
specs/
# GSD meta / surface state
.gsd/
.gsd-profile

# ── GSD baseline (auto-generated) ──
.gsd
.gsd-worktrees/
.gsd-backups/
.gsd-id
.mcp.json
.bg-shell/

# ── Agent tooling installed by GSD / pi (regenerable, not project code) ──
# Vendored skill packs (.agents/skills, .devin/skills) and agent definitions
# (.devin/agents) are local tool state like .gsd/ — keep out of git so the
# pre-commit ruff/ty hooks don't lint vendored scripts and block auto-commits.
.agents/
.devin/
skills-lock.json
